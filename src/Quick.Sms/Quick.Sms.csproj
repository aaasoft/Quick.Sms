<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;net6.0;net8.0;net10.0</TargetFrameworks>
    <PackageProjectUrl>https://cnb.cool/scbeta/Quick.Sms</PackageProjectUrl>
    <PackageIcon>Logo.png</PackageIcon>
    <RepositoryUrl>https://cnb.cool/scbeta/Quick.Sms</RepositoryUrl>
    <Description>Send sms with Wireless module(GSM/LTE etc).</Description>
    <Version>2026.1.107</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\resource\Logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
	<Choose>
		<When Condition=" '$(TargetFramework)'=='net6.0' ">
			<ItemGroup>
				<PackageReference Include="System.IO.Ports" Version="6.0.0" />
			</ItemGroup>
		</When>
    <When Condition=" '$(TargetFramework)'=='net8.0' ">
			<ItemGroup>
				<PackageReference Include="System.IO.Ports" Version="8.0.0" />
			</ItemGroup>
		</When>
    <When Condition=" '$(TargetFramework)'=='net10.0' ">
			<ItemGroup>
				<PackageReference Include="System.IO.Ports" Version="10.0.1" />
			</ItemGroup>
		</When>
	</Choose>
  <ItemGroup>
    
  </ItemGroup>

</Project>
